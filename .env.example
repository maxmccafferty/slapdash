# Server environment. In local dev this file's copy (.env, gitignored) is read by the Vite
# dev server's /api/claude handler only; on Vercel, set these in the project settings.
# Only VITE_* variables ever reach the browser: never give ANTHROPIC_API_KEY a VITE_ prefix.

# Anthropic API key. Leave empty and the chat shows "Claude isn't connected".
ANTHROPIC_API_KEY=

# Monthly Claude budget in USD (default 10). The server warns at 80% and stops at the cap
# until the first of next month (UTC). Also set the same spending limit in the Anthropic
# Console (Settings → Limits): it is the hard backstop.
SLAPDASH_MONTHLY_BUDGET_USD=

# Model (default claude-sonnet-5-5), effort (low | medium | high | xhigh | max, default
# medium), max output tokens per reply (default 32000), and the refusal fallback (on | off,
# default on).
SLAPDASH_MODEL=
SLAPDASH_EFFORT=
SLAPDASH_MAX_TOKENS=
SLAPDASH_FALLBACKS=

# Per-user rate limits (users are identified by a hash of their IP). Defaults 30 and 1000.
SLAPDASH_RATE_PER_MINUTE=
SLAPDASH_RATE_PER_DAY=

# Extra origins allowed to POST to /api/claude, comma-separated (the app's own host is
# always allowed), e.g. https://slapdash.example
SLAPDASH_ALLOWED_ORIGINS=

# Where local dev keeps spend and rate-limit counters (default .data/usage.json at the repo root).
SLAPDASH_USAGE_FILE=

# Optional: Upstash Redis for spend and rate limits on a deployment (Vercel Marketplace →
# Upstash adds these). Without it a deployment keeps counters in memory, which reset on cold
# starts. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Default project location for design loads (snow, wind, frost depth), e.g. "City, ST"
SLAPDASH_DEFAULT_LOCATION=
