{
  "name": "@slapdash/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Slapdash web app: the app shell (header units, view controls, floors, chat panel) built from the design tokens, and the 3D renderer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "tokens": "node scripts/build-tokens.ts",
    "e2e": "playwright test",
    "check:secrets": "node scripts/check-bundle-secrets.ts",
    "sample": "node scripts/build-sample.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@slapdash/agent": "workspace:*",
    "@slapdash/catalog": "workspace:*",
    "@slapdash/core": "workspace:*",
    "@slapdash/solver": "workspace:*",
    "@slapdash/storage": "workspace:*",
    "lucide-react": "^1.79.0",
    "pdf-lib": "^1.17.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.4",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@react-three/test-renderer": "^9.1.1",
    "@slapdash/keyhole": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
